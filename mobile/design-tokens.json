        "scaleFactor": 1.0,
        "styles": {
          "display/xl": { "fontSize": 22, "lineHeight": 30, "fontWeight": "800" },
          "heading/lg": { "fontSize": 18, "lineHeight": 26, "fontWeight": "800" },
