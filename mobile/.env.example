# SmartWard AI Mobile Environment Configuration (Expo SDK 52)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Google Maps SDK API Key for Android / iOS (Tùy chọn)
# Các API cần kích hoạt trên Google Cloud Console:
# 1. Maps SDK for Android
# 2. Maps SDK for iOS
# Khuyến nghị bảo mật:
# - Android: Giới hạn theo Android Package Name (vn.edu.uth.smartward.mobile) + SHA-1 certificate fingerprint
# - iOS: Giới hạn theo iOS Bundle ID (vn.edu.uth.smartward.mobile)
# Lưu ý: Ứng dụng mặc định dùng expo-location reverseGeocodeAsync không tốn chi phí và không cần API key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
