# ==============================================================================
# SMARTWARD AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sao chép tệp này thành .env trước khi khởi chạy: cp .env.example .env
# Lưu ý: Trong môi trường Production, bắt buộc thay đổi tất cả mật khẩu & khóa!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=smartward_db
POSTGRES_USER=smartward
POSTGRES_PASSWORD=smartward_change_me_in_prod_2026
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. IN-MEMORY CACHE & GEO INDEX (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. ZERO-TRUST OBJECT STORAGE (MinIO)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_change_me_in_prod_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=smartward-vault

# ------------------------------------------------------------------------------
# 4. ZERO-TRUST VAULT & OFFICER SECURITY SECRETS (Bắt buộc >= 32 bytes)
# ------------------------------------------------------------------------------
# Khóa AES-256-GCM phải có độ dài chính xác 32 bytes (256-bit)
VAULT_ENCRYPTION_KEY=SmartWardAI_ChangeMe_32BytesKey!
VAULT_FAIL_CLOSED=true

# Khóa ký HMAC-SHA256 cho phiên xác thực Cán bộ (tối thiểu 32 bytes)
JWT_SECRET=SmartWardAI_Officer_JwtSecret_ChangeMe_32B!
OFFICER_TOKEN_TTL_HOURS=8
ENFORCE_OFFICER_AUTH=true

# ------------------------------------------------------------------------------
# 5. RAG & SPATIAL TRIAGE PARAMETERS (Single Source of Truth)
# ------------------------------------------------------------------------------
RAG_DEFAULT_THRESHOLD=0.78
RAG_THETA_LOWER=0.42
TRIAGE_CLUSTER_RADIUS_M=25.0
TRIAGE_SIMILARITY_THRESHOLD=0.80

# ------------------------------------------------------------------------------
# 6. BACKEND SPRING BOOT (Java 21) & AI CLIENT
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
GEMINI_API_KEY=mock-offline-mode
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# 7. CORS & FRONTEND
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
