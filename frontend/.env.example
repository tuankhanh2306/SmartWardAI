# SmartWard AI Frontend Environment Configuration
VITE_API_BASE_URL=http://localhost:8082/api/v1
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# Google Maps Platform JavaScript API Key (Tùy chọn - Tự động dự phòng sang OpenStreetMap/Leaflet khi để trống)
# Các API cần kích hoạt trên Google Cloud Console:
# 1. Maps JavaScript API
# 2. Geocoding API
# Khuyến nghị bảo mật & chi phí:
# - Giới hạn khóa theo HTTP Referrers: http://localhost:3000/*, http://localhost:8081/*, https://*.smartward.vn/*
# - Thiết lập hạn mức ngân sách và cảnh báo chi phí (Budget Alert) trong Google Cloud Billing
VITE_GOOGLE_MAPS_API_KEY=
